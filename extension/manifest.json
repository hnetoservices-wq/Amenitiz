{
  "manifest_version": 3,
  "name": "Amenitiz — Rate Organizer",
  "version": "0.2.0",
  "description": "Organize Amenitiz rate plans, improve inventory controls and add persistent interface themes.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://*.amenitiz.io/*/admin/*"],
      "js": ["themes.js"],
      "css": ["themes.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.amenitiz.io/*/admin/*"],
      "js": ["content.js", "inventory.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
