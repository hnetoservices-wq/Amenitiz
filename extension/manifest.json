{
  "manifest_version": 3,
  "name": "Amenitiz — Rate Organizer",
  "version": "0.1.5",
  "description": "Organize Amenitiz rate plans and keep date pickers near selected dates.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://*.amenitiz.io/*/admin/*"],
    "js": ["content.js", "inventory.js", "calendar-position.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
